# Ray Zhang - Reach service. Use a protected environment file in production.
REACH_LISTEN_HOST=127.0.0.1
REACH_PORT=18910
REACH_PUBLIC_ORIGIN=http://127.0.0.1:18910
REACH_DEVELOPMENT=1
REACH_DATA_DIR=work/service
REACH_BOOTSTRAP_USERNAME=ray
# Set a newly generated password (at least 16 characters) before first start.
REACH_BOOTSTRAP_PASSWORD=
# Only configure after the ingress overwrites X-Reach-Client-IP correctly.
REACH_TRUSTED_PROXY_ADDRESSES=
# Optional organization model for on-device delegation. Leave ALL blank to disable.
# Endpoint must end in /v1; HTTP literal loopback is development-only.
REACH_AGENT_MODEL_URL=
REACH_AGENT_MODEL_ID=
REACH_AGENT_MODEL_TOKEN=
REACH_AGENT_MODEL_CONTEXT=
REACH_AGENT_MODEL_MAX_OUTPUT=
# Explicit organization declaration, not an observed model capability: 0 or 1.
REACH_AGENT_MODEL_IMAGE_INPUT=
